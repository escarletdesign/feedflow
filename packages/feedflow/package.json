{
  "name": "@escarlet/feedflow",
  "version": "0.1.0",
  "description": "FeedFlow — mobile-first vertical narrative UX framework for React",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/feedflow.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && mkdir -p dist/styles && cp src/styles/feedflow.css dist/styles/feedflow.css",
    "typecheck": "tsc --noEmit",
    "check": "node --experimental-strip-types src/lib/snapAnchor.check.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "framer-motion": ">=11"
  },
  "peerDependenciesMeta": {
    "@studio-freight/lenis": {
      "optional": true
    },
    "lenis": {
      "optional": true
    },
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
